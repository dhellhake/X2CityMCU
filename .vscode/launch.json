            "configFiles": [
                "${workspaceFolder}/.devenv/openocd/atmel-ice-mimxrt1061.cfg"
            ],
            "openOCDPreConfigLaunchCommands": [
                "set X2_PROBE_SERIAL {${config:x2city.atmelIceSerial}}",
                "set X2_ADAPTER_SPEED_KHZ ${config:x2city.atmelIceSpeedKHz}"
            ]
        },
        {
            "type": "cortex-debug",
            "request": "attach",
            "name": "Attach i.MX RT1061 QSPI release (Atmel-ICE SWD)",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "C:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/target/thumbv7em-none-eabihf/release/ExhValveAct-qspi.elf",
            "configFiles": [
                "${workspaceFolder}/.devenv/openocd/atmel-ice-mimxrt1061.cfg"
